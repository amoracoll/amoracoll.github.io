---
import { getEntry } from "astro:content";
import ThemeToggle from "./ThemeToggle.astro";

const NAV_LINKS = [
  { href: "/experience", label: "Experience" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];

const site = await getEntry("site", "profile");
const currentPath = Astro.url.pathname.replace(/\/$/, "");

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="border-b border-zinc-200 px-4 md:px-6 dark:border-zinc-800">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4"
  >
    <a href="/" class="rounded font-semibold">
      {site?.data.name}
    </a>
    <div class="flex items-center gap-4 text-sm md:gap-6">
      <ul class="flex gap-4 md:gap-6">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class="rounded text-zinc-600 transition-colors duration-150 hover:text-zinc-900 aria-[current=page]:text-blue-600 dark:text-zinc-400 dark:hover:text-zinc-100 dark:aria-[current=page]:text-blue-400"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
