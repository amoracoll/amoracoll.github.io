---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import {
  formatDate,
  getSortedProjects,
  type Project,
} from "../../lib/projects";

interface Props {
  project: Project;
}

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, date, tags, repo, demo } = project.data;
const { Content } = await render(project);

const links = [
  { href: repo, label: "GitHub repo" },
  { href: demo, label: "Demo" },
].filter((link): link is { href: string; label: string } => Boolean(link.href));
---

<BaseLayout title={`${title} — Arnau Mora Coll`} description={summary}>
  <article class="mx-auto flex max-w-3xl flex-col gap-6">
    <header class="flex flex-col gap-3">
      <h1 class="text-3xl font-bold">{title}</h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400">{summary}</p>
      <time
        datetime={date.toISOString()}
        class="font-mono text-sm text-zinc-600 dark:text-zinc-400"
      >
        {formatDate(date)}
      </time>
      <TagList tags={tags} />
      {links.length > 0 && (
        <ul class="flex gap-4">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded text-blue-600 underline-offset-4 hover:underline dark:text-blue-400"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <div class="flex flex-col gap-4 [&_h2]:mt-6 [&_h2]:text-xl [&_h2]:font-semibold">
      <Content />
    </div>
  </article>
</BaseLayout>
